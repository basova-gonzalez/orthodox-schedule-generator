{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/orthodox-schedule-generator/month.schema.json",
  "title": "Расписание на один месяц и один язык",
  "description": "Все даты гражданские. Дата каждого дня должна принадлежать year/month; уникальность и принадлежность месяцу дополнительно проверяет генератор. Код language должен быть в settings.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "year",
    "month",
    "language",
    "days"
  ],
  "properties": {
    "year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2099
    },
    "month": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,8}(-[A-Za-z0-9]{2,8})*$",
      "description": "Код с подписями в settings.json, например ru или en."
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "description",
          "services"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Гражданская дата YYYY-MM-DD внутри year/month, без повторов."
          },
          "description": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Строки описания как в источнике, без HTML-разметки."
          },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "time",
                "title",
                "hours",
                "priest"
              ],
              "properties": {
                "time": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                  "description": "Время начала службы HH:MM. Если неизвестно, спросите составителя расписания."
                },
                "title": {
                  "type": "string",
                  "description": "Непустое название службы как в источнике; если его нельзя определить, спросите составителя.",
                  "pattern": "\\S"
                },
                "hours": {
                  "type": "string",
                  "description": "Часы работы храма как в источнике; пустая строка, если их нет."
                },
                "priest": {
                  "type": "string",
                  "description": "Имя или подпись священника как в источнике; пустая строка, если их нет."
                }
              }
            }
          }
        }
      }
    }
  }
}
